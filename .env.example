# ค่าตั้งค่าสำหรับรันบนเครื่องตัวเอง / server บริษัท
#
# วิธีใช้: คัดลอกไฟล์นี้เป็น ".env" (ชื่อไฟล์ขึ้นต้นด้วยจุด ไม่มีนามสกุล) แล้วใส่ค่าจริง
# ⚠️ ห้ามนำไฟล์ .env ขึ้น git หรือส่งให้ใคร (ถูกกันไว้ใน .gitignore แล้ว)

# ---------- Google Sheets ----------

# รหัสของไฟล์ Google Sheet ดูได้จาก URL ส่วนที่อยู่ระหว่าง /d/ กับ /edit
SPREADSHEET_ID="1utgGVyDGtof8rh_fe9VtqcNPmyf61lbEkqwS6spMxc0"

# อีเมลของ service account (ค่า client_email ในไฟล์ JSON ที่ดาวน์โหลดมา)
# อย่าลืมแชร์ Google Sheet ให้อีเมลนี้เป็น "ผู้แก้ไข" ด้วย
GOOGLE_SERVICE_ACCOUNT_EMAIL="aircon-worker@xxxxx.iam.gserviceaccount.com"

# ค่า private_key ในไฟล์ JSON — คัดลอกมา "ทั้งบรรทัด" ตามที่เห็นในไฟล์
# คือเป็นบรรทัดเดียวที่มี \n เป็นตัวอักษรสองตัวคั่นอยู่ข้างใน
# ⚠️ อย่ากด Enter ขึ้นบรรทัดใหม่จริง ระบบจะอ่านค่าไม่ออก
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# ---------- ทั่วไป ----------

# พอร์ตที่ให้ระบบเปิดรอ (ไม่ระบุจะใช้ 8787)
PORT="8787"

# ---------- บริการสร้าง PDF (ไม่ใส่ก็ได้) ----------
# เมนูอื่นทำงานได้ครบโดยไม่ต้องตั้งค่า 2 ค่านี้
# ใส่เมื่อต้องการให้ฟอร์มล้างแอร์ออกไฟล์ PDF ได้ (ดูขั้นตอนใน README)

PDF_SERVICE_URL=""
PDF_SERVICE_SECRET=""
