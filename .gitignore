# ค่าลับ — ห้ามขึ้น git เด็ดขาด
.env
.env.backup

# ไฟล์กุญแจของ service account ที่ Google ตั้งชื่อให้เอง
# ชื่อไฟล์เดาไม่ได้ล่วงหน้า (เช่น aircon-manager-506605-bbcb70a13c66.json)
# จึงกันไฟล์ .json ทุกไฟล์ที่วางไว้ชั้นนอกสุดไว้ก่อน แล้วค่อยเปิดทางให้เฉพาะที่จำเป็น
# ปลอดภัยกว่าการไล่เขียนชื่อทีละไฟล์ เพราะถ้าลืมไฟล์ไหนคือกุญแจหลุดทันที
/*.json
!/package.json
!/package-lock.json

# session ของผู้ใช้ที่กำลังล็อกอินอยู่
.sessions.json
.sessions.json.tmp

# ฐานข้อมูล — เป็นข้อมูลจริงของบริษัท ไม่ใช่โค้ด
# และตอนนี้ยังมีรหัสผ่านผู้ใช้เก็บเป็นข้อความธรรมดาอยู่ข้างใน
# ห้ามขึ้น git เด็ดขาด ต้องสำรองด้วยวิธีอื่น (ดู README หัวข้อสำรองข้อมูล)
data/
*.db
*.db-wal
*.db-shm

node_modules/
dist/

