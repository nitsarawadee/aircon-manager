{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aircon-manager",
  "main": "platform/cloudflare.js",
  "compatibility_date": "2025-08-01",

  // เสิร์ฟหน้าเว็บ (web/index.html) เป็นไฟล์ static จาก CDN ของ Cloudflare
  // request ที่ขึ้นต้นด้วย /api จะวิ่งเข้า Worker แทน (ตั้งค่าใน run_worker_first)
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Durable Object ตัวเดียว ทำหน้าที่ 2 อย่าง:
  //   1) เก็บ session token (แทน CacheService ของ Apps Script)
  //   2) เป็น lock กันเขียนข้อมูลชนกัน (แทน LockService)
  // ใช้ DO แทน KV เพราะ KV ฟรีจำกัดการเขียนแค่ 1,000 ครั้ง/วัน ซึ่งไม่พอ
  // (ทุกครั้งที่เรียก API ต้องต่ออายุ session = เขียน 1 ครั้ง)
  "durable_objects": {
    "bindings": [
      { "name": "APP_STATE", "class_name": "AppState" }
    ]
  },

  // DO บนแพลนฟรีรองรับเฉพาะ storage แบบ SQLite เท่านั้น
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AppState"]
    }
  ],

  "vars": {
    // ใส่ค่าจริงตอน deploy หรือแก้ตรงนี้ก็ได้ (ไม่ใช่ความลับ)
    "SPREADSHEET_ID": "1utgGVyDGtof8rh_fe9VtqcNPmyf61lbEkqwS6spMxc0",
    "TIMEZONE": "Asia/Bangkok",

    // URL ของ Apps Script ที่เหลือไว้ทำ PDF + Drive อย่างเดียว
    // เว้นว่างได้ ระบบจะทำงานปกติทุกอย่าง ยกเว้นการสร้าง PDF ฟอร์มล้างแอร์
    "PDF_SERVICE_URL": ""
  },

  "observability": {
    "enabled": true
  }

  // ค่าลับที่ต้องตั้งด้วย `wrangler secret put` (ห้ามใส่ในไฟล์นี้):
  //   GOOGLE_SERVICE_ACCOUNT_EMAIL   อีเมลของ service account
  //   GOOGLE_PRIVATE_KEY             private key จากไฟล์ JSON ของ service account
  //   PDF_SERVICE_SECRET             รหัสลับที่ใช้คุยกับ Apps Script ฝั่ง PDF
}
